  confidence      Float
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

model LearningOrchestrationState {
  id              String   @id @default(uuid())
  tenantId        String
  workflowId      String
  state           String
  retries         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model PromotionDecision {
  id              String   @id @default(uuid())
  tenantId        String
  candidateId     String
  decision        String   // REJECT, HOLD, SHADOW, STAGED, APPROVED_FOR_PROMOTION
